# eliciter configuration. Copy to .env and adjust; .env is gitignored.
#
# Secrets are NOT duplicated here. The ArcadeDB password is read from indexia's own
# docker/.env at run time (see ELICITER_INDEXIA_ROOT), so there is exactly one copy
# of it on this machine and rotating it there is enough.

# ---- where the sources live -------------------------------------------------
ELICITER_INDEXIA_ROOT=/home/aphorikles/indexia
ELICITER_PERCEPTUA_POSTS=/home/aphorikles/perceptua/perceptua/_posts

# ---- arxiv (source 3, implemented natively) ---------------------------------
# Categories to sweep, comma-separated. arxiv taxonomy names.
ELICITER_ARXIV_CATEGORIES=cs.AI,cs.LG,cs.NE,q-bio.NC,nlin.AO
# How far back a weekly sweep looks, and how many results to pull per category page.
ELICITER_ARXIV_LOOKBACK_DAYS=7
ELICITER_ARXIV_MAX_RESULTS=300
# arxiv asks for ~1 request per 3s. Do not lower this.
ELICITER_ARXIV_DELAY=3.0
# The reading queue holds at most this many papers. A sweep tops it up rather than
# replacing it: unread papers stay, read ones free a slot, rejected ones never return.
ELICITER_ARXIV_KEEP=10

# ---- what you care about ----------------------------------------------------
# The main dial. Papers are ranked by term overlap with these plus your indexia corpus,
# and the digest names the terms that matched, so tuning this is a feedback loop rather
# than a guess. Stating an interest here works from cold — before any note mentions it.
# Seeded from the corpus as it stood 2026-08-26 (Levin-adjacent agency work).
ELICITER_INTERESTS=agency, agents, goal-directed behaviour, collective intelligence, basal cognition, morphogenesis, causal emergence, alignment, learnable novelty, autopoiesis, self-organization, active inference, developmental biology, cognitive boundaries

# The counterweight. Bag-of-words cannot tell your sense of a word from the field's:
# "agents" means Levin's cells to you and LLM tool-callers to most of cs.AI, so without
# this every agent-harness paper matches. Each excluded term an abstract contains costs
# it points, so a passing mention survives and a paper *about* the thing sinks.
# Seeded from what actually surfaced as noise on the 2026-08-26 sweep; tune it by reading
# the `matched` terms in the digest and adding whatever keeps dragging papers in.
ELICITER_EXCLUDE=benchmark, leaderboard, refactor, payment, vulnerability, malware, software engineering, code generation

# ---- elicitation ------------------------------------------------------------
# How many prompts a run renders, at most.
ELICITER_MAX_PROMPTS=7

# ---- local UI ---------------------------------------------------------------
# Bound to 127.0.0.1 only. 8420 is indexia's UI; 8080 and 8765 are kept clear.
ELICITER_UI_PORT=8473

# ---- no embeddings ----------------------------------------------------------
# eliciter does not embed anything and does not need Ollama running. Ranking is term
# overlap against the interest profile above. This was measured, not assumed: embedding
# an abstract costs 1-3 minutes on this machine's CPU-only Ollama, which made a weekly
# sweep an hour-long job to catch vocabulary mismatches inferred from four notes.
# See eliciterlib/rank.py for the full reasoning, and revisit it if a GPU appears.
#
# indexia still embeds its own notes — that is its business and is unaffected.
