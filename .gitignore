# Secrets and machine-local overrides.
.env

# Tailscale-issued TLS cert/key for --tailscale, machine-local.
.certs/

# Generated output. Prompts and digests are derived — regenerate them.
prompts/*.md
digest/*.md

# The reading queue is real state, not derived: it holds which papers you have read and
# rejected, and a sweep cannot reconstruct it. Ignored here only because it is personal
# rather than shared; back it up if you care about it.
state/

# Ad-hoc writing and scanned notes — the user's own material, dropped here as a source. Not
# eliciter's to publish; back it up separately if you care about it.
misc/

# Your tweets, one .md per tweet — imported from an X archive, or saved when you mark a
# drafted tweet posted. Your own writing and the evidence for the voice profile; never
# committed.
tweets/

__pycache__/
*.py[cod]
